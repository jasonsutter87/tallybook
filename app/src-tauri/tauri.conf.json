{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tallybook",
  "version": "0.2.0",
  "identifier": "app.tallybook.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tallybook",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Self-hosted bookkeeping",
    "longDescription": "Open-source double-entry bookkeeping with bank feeds, invoices, bills and reports. Your books live in one file on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQ0YyQzhBRkYzNDZCQTcKUldTbmF6VC9paXpQcndnV0hBZ0NvQ0xzUHFMQjhrR1pTaStTajlHMk1SSmVNbS9XQjErSGQzN0cK",
      "endpoints": [
        "https://github.com/jasonsutter87/tallybook/releases/latest/download/latest.json"
      ]
    }
  }
}
