# Example settings for tally-connect. Copy to a root-owned file (mode 0600)
# OUTSIDE the repository, and fill in real values there. Never commit real keys.

CONNECT_DB=/var/lib/tally-connect/connect.db
# Long random string: openssl rand -base64 32. Back it up separately from the DB.
CONNECT_DB_KEY=replace-me

PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
# sandbox or production
PLAID_ENV=sandbox

LS_STORE_ID=replace-me
# Comma list of the paid product ids that include bank sync.
LS_PRODUCT_IDS=replace-me,replace-me

BIND=127.0.0.1:8787
MAX_ITEMS_PER_LICENSE=10
LAPSE_GRACE_DAYS=30

# Behind Cloudflare Tunnel:  CF-Connecting-IP
# Behind Caddy:              X-Forwarded-For
#CLIENT_IP_HEADER=X-Forwarded-For
